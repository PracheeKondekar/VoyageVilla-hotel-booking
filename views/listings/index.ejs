<% layout("/layouts/boilerplate.ejs") %>
<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .filters {
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
    cursor: pointer;
  }

  .filters:hover {
    opacity: 1;
  }

  .tax-info {
    display: none;
  }

  .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    height: 3rem;
    padding: 1rem;
    margin-left: auto;   /* pushes toggle to right */
    margin-top: 1rem;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
</style>
